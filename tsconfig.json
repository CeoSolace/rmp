cd /d C:\Windows\System32\propergeeks-rebuild

set PATH=%PATH%;%APPDATA%\npm

npm install -g pm2
cd server
npm install

powershell -NoProfile -Command "$p='server.js'; $s=Get-Content $p -Raw; if($s -notmatch 'function makeRef'){ $fn=@'
function makeRef(prefix, table, column){
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
  const letters = Array.from({length:3}, () => chars[Math.floor(Math.random()*chars.length)]).join('');
  const nums = String(Math.floor(Math.random()*900)+100);
  const ref = prefix + '-' + letters + nums;
  try {
    if (typeof db !== 'undefined' && table && column) {
      const exists = db.prepare('SELECT id FROM ' + table + ' WHERE ' + column + '=?').get(ref);
      return exists ? makeRef(prefix, table, column) : ref;
    }
  } catch(e){}
  return ref;
}

'@; $s=$s -replace 'const app=express\(\);', ($fn + 'const app=express();'); Set-Content $p $s }"

node -c server.js

pm2 delete propergeeks-api
pm2 start server.js --name propergeeks-api

cd ..\client
npm install
npm run build

pm2 delete propergeeks-web
pm2 start node_modules\vite\bin\vite.js --name propergeeks-web -- --host 0.0.0.0 --port 3002

netsh advfirewall firewall add rule name="ProperGeeks3002" dir=in action=allow protocol=TCP localport=3002
netsh advfirewall firewall add rule name="ProperGeeks3003" dir=in action=allow protocol=TCP localport=3003

pm2 save --force
pm2 status
