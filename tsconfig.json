cd /d C:\Windows\System32\propergeeks-rebuild\server

powershell -NoProfile -ExecutionPolicy Bypass -Command "$p='server.js'; $s=Get-Content $p -Raw; $s=[regex]::Replace($s,'function makeRef[\s\S]*?app\.get\(\"/api/health\"','app.get(\"/api/health\"'); $fn=@'
function makeRef(prefix, table, column){
  const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ";
  const letters = Array.from({length:3}, function(){
    return chars[Math.floor(Math.random() * chars.length)];
  }).join("");
  const nums = String(Math.floor(Math.random() * 900) + 100);
  const ref = String(prefix || "REF") + "-" + letters + nums;
  try{
    if(typeof db !== "undefined" && table && column){
      const exists = db.prepare("SELECT id FROM " + table + " WHERE " + column + "=?").get(ref);
      return exists ? makeRef(prefix, table, column) : ref;
    }
  }catch(e){}
  return ref;
}

'@; $s=$s -replace 'const app=express\(\);', ($fn + 'const app=express();'); Set-Content -Encoding UTF8 $p $s"

node -c server.js