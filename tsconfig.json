powershell -Command "$p='server.js'; $s=Get-Content $p -Raw; if($s -notmatch 'function makeRef'){ $insert=@'
function makeRef(prefix, table, column){
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
  const letters = Array.from({length:3}, () => chars[Math.floor(Math.random()*chars.length)]).join('');
  const nums = String(Math.floor(Math.random()*900)+100);
  const ref = `${prefix}-${letters}${nums}`;
  try {
    const exists = db.prepare(`SELECT id FROM ${table} WHERE ${column}=?`).get(ref);
    return exists ? makeRef(prefix, table, column) : ref;
  } catch {
    return ref;
  }
}

'@; $s=$s -replace 'const app=express\(\);', ($insert + 'const app=express();'); Set-Content $p $s }"

