import React, {useEffect,useState} from 'react';

export default function Workflow(){
const [templates,setTemplates]=useState([]);
const [selected,setSelected]=useState(null);
const [answers,setAnswers]=useState({});
const [canEdit,setCanEdit]=useState(false);

async function api(url,opt={}){
 const r=await fetch('/api'+url,{
  credentials:'include',
  headers:{'Content-Type':'application/json'},
  ...opt
 });
 if(!r.ok) throw new Error(await r.text());
 return r.json();
}

useEffect(()=>{
 api('/workflows').then(x=>{
  setTemplates(x.templates||[]);
  setCanEdit((x.permissions||[]).includes('view_audits'));
 });
},[]);

async function save(status){
 await api('/workflows/run',{
  method:'POST',
  body:JSON.stringify({
   template_id:selected.id,
   answers,
   status
  })
 });
 alert(status==='submitted'?'Audit submitted':'Draft saved');
}

return <div className='workflow-page'>
<h1>Workflows</h1>

{!selected && templates.map(t=>
<button key={t.id} onClick={()=>setSelected(t)}>
{t.name}
</button>
)}

{selected &&
<div>
<button onClick={()=>setSelected(null)}>Back</button>

<h2>{selected.name}</h2>

{selected.categories?.map(c=>
<section key={c.id}>
<h3>{c.name}</h3>

{c.questions?.map(q=>
<div key={q.id}>
<label>{q.label}</label>
<input
value={answers[q.id]||''}
onChange={e=>setAnswers({
 ...answers,
 [q.id]:e.target.value
})}
/>
</div>
)}

{canEdit &&
<button>Edit Category</button>}
</section>
)}

<button onClick={()=>save('draft')}>
Save Draft
</button>

<button onClick={()=>save('submitted')}>
Submit Audit
</button>

{canEdit &&
<div>
<h3>Workflow Editor</h3>
<button>Add Category</button>
<button>Add Question</button>
</div>
}

</div>}
</div>
}
